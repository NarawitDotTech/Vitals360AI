# Vitals360 AI — environment variables
# Copy this file to .env.local for local development.
# On Vercel: add these under Project Settings -> Environment Variables.

# Base URL of the skin disease detection service used by /api/classify/derm.
# The public demo instance (free Render tier) sleeps after ~15 min of
# inactivity and takes 60-90s to wake up. For reliable results deploy your
# own instance of https://github.com/pacificrm/skinDiseasesDetection and
# point this variable at it:
SKINDETECT_API_URL=https://skindiseasesdetect-2.onrender.com

# Optional: API key for the detection service, sent as a Bearer token.
# Only needed if your deployment requires authentication.
SKINDETECT_API_KEY=
